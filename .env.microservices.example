# Autonomous Content Service - Microservices Environment Variables
# Copy this file to .env and fill in your actual values

# LLM Configuration
LLM_API_KEY=your_openai_api_key_here
LLM_MODEL=gpt-4
LLM_MAX_TOKENS=2000
LLM_TEMPERATURE=0.7

# Search Configuration
SEARCH_API_KEY=your_search_api_key_here
SEARCH_URL=https://api.bing.microsoft.com/v7.0/search

# Content Creation Configuration
CONTEXT_WINDOW_SIZE=8000
ENABLE_FACT_CHECKING=true
ENABLE_PLAGIARISM=true
ENABLE_SEO=true

# Payment Processing Configuration
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Database Configuration (Docker Compose default)
DATABASE_URL=postgres://postgres:postgres@postgres:5432/contentservice?sslmode=disable

# Redis Configuration (Docker Compose default)
REDIS_URL=redis://redis:6379

# Consul Configuration (Docker Compose default)
CONSUL_URL=consul:8500

# Service Ports (Docker Compose defaults)
API_GATEWAY_PORT=8080
CONTENT_SERVICE_PORT=8081
DECISION_SERVICE_PORT=8082
FINANCIAL_SERVICE_PORT=8083
GOVERNANCE_SERVICE_PORT=8084
HR_SERVICE_PORT=8085
LEGAL_SERVICE_PORT=8086
RISK_SERVICE_PORT=8087
SELF_IMPROVEMENT_SERVICE_PORT=8088

# Monitoring Configuration
PROMETHEUS_URL=http://prometheus:9090
GRAFANA_URL=http://grafana:3000

# Security Configuration
JWT_SECRET=your_jwt_secret_here
ENCRYPTION_KEY=your_32_byte_encryption_key_here

# External APIs
WEATHER_API_KEY=your_weather_api_key_here
NEWS_API_KEY=your_news_api_key_here
SOCIAL_MEDIA_API_KEY=your_social_media_api_key_here